# Copy to .env for local dev (falls back to http://localhost:5000/api if
# unset, which is correct for local dev — that fallback is NOT safe for a
# production build, see src/lib/axios.ts).
#
# For a production build, this MUST be set to the real deployed backend's
# public URL at build time (Vite bakes env vars in at build, not runtime):
#   VITE_API_URL=https://api.yourrealdomain.com/api

VITE_API_URL=http://localhost:5000/api
