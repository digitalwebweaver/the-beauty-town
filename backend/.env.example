NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=salon_db

ACCESS_TOKEN_SECRET=please_generate_a_long_random_string
REFRESH_TOKEN_SECRET=please_generate_a_different_long_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Web Push (staff/admin notifications). Generate a real pair with
# `npx web-push generate-vapid-keys` — never reuse this example pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
